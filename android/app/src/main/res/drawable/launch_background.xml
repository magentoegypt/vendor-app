<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash (DEV15): the Hub Market vendor splash, centred on its own edge colour so a
     screen of another shape shows no white bars. Sized per density in drawable-*dpi/ic_splash.jpg. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B58C6F" />
        </shape>
    </item>

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_splash" />
    </item>
</layer-list>
